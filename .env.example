# ==========================================
# MongoDB Configuration
# ==========================================
# Connect to MongoDB Atlas or local MongoDB instance
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# ==========================================
# Cloudinary Configuration (Media Storage)
# ==========================================
# Obtain from Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# SMTP Email Configuration (Nodemailer)
# ==========================================
# For Gmail, use an "App Password" (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Portfolio Contact" <your_email@gmail.com>

# Destination email where contact form submissions will be received
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# ==========================================
# Admin Authentication
# ==========================================
ADMIN_USERNAME=admin@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password

# ==========================================
# App Settings
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
